<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.arc" name="Arc" version="0.1.0" provider-name="The Arc Media Server Authors">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.six" version="1.11.0" optional="true"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Arc Media Server, full screen</summary>
    <description lang="en_GB">A full-screen client for Arc Media Server: its own interface for browsing and playing your films and shows, signed in to your Arc server with a code. Uses only Arc's stable API; never changes your Kodi library.</description>
    <platform>all</platform>
    <license>AGPL-3.0-only</license>
    <source>https://github.com/arc-media-server/arc-kodi</source>
    <website>https://github.com/arc-media-server/arc-media-server</website>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
