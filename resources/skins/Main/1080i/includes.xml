<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <!-- Arc's colours (web dark tokens; the same as the Apple app's Theme.swift). No UI colour:
       chosen and main controls are white with black text; the teal is the logo's alone. -->
  <constant name="bg">FF1C1D21</constant>
  <constant name="surface">FF26272D</constant>
  <constant name="surface2">FF2F3038</constant>
  <constant name="fg">FFF5F5F7</constant>
  <constant name="muted">FFA1A1AD</constant>
  <constant name="subtle">FF6B6B78</constant>
  <constant name="scrim">CC000000</constant>
  <constant name="white">FFFFFFFF</constant>
  <constant name="black">FF000000</constant>

  <include name="PageBackground">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-wash.png</texture>
    </control>
  </include>

  <!-- Artwork-led background: the focused title's fanart, darkened. -->
  <include name="HeroBackground">
    <param name="id" default="60"/>
    <definition>
      <control type="image" id="$PARAM[id]">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <aspectratio>scale</aspectratio>
        <fadetime>300</fadetime>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>arc-scrim.png</texture>
      </control>
    </definition>
  </include>

  <!-- A white, black-text button (the page's main action and chosen place). -->
  <include name="PrimaryButton">
    <param name="width" default="320"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>black</textcolor>
      <focusedcolor>black</focusedcolor>
      <disabledcolor>subtle</disabledcolor>
      <texturefocus border="8">arc-pill-white.png</texturefocus>
      <texturenofocus border="8">arc-pill-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
    </definition>
  </include>

  <include name="RoundButton">
    <param name="width" default="76"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <texturefocus border="38">arc-round-white.png</texturefocus>
      <texturenofocus border="38">arc-round-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
    </definition>
  </include>

  <!-- A poster card for a horizontal row or the grid. -->
  <include name="PosterItemLayout">
    <param name="focused" default="false"/>
    <definition>
      <control type="group">
        <control type="image">
          <left>8</left><top>8</top><width>244</width><height>366</height>
          <aspectratio>scale</aspectratio>
          <texture background="true">$INFO[ListItem.Art(poster)]</texture>
          <bordertexture border="3">arc-card-border.png</bordertexture>
          <bordersize>3</bordersize>
        </control>
        <control type="image">
          <left>8</left><top>8</top><width>244</width><height>366</height>
          <visible>!String.IsEmpty(ListItem.Property(progress))</visible>
          <texture>arc-progress-scrim.png</texture>
        </control>
        <control type="label">
          <left>12</left><top>380</top><width>236</width><height>30</height>
          <font>arc-small</font><align>center</align>
          <textcolor>fg</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>12</left><top>410</top><width>236</width><height>26</height>
          <font>arc-small</font><align>center</align>
          <textcolor>muted</textcolor>
          <label>$INFO[ListItem.Label2]</label>
        </control>
      </control>
    </definition>
  </include>

  <include name="ThumbItemLayout">
    <definition>
      <control type="group">
        <control type="image">
          <left>8</left><top>8</top><width>440</width><height>248</height>
          <aspectratio>scale</aspectratio>
          <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="label">
          <left>12</left><top>262</top><width>432</width><height>30</height>
          <font>arc-small</font><align>center</align><textcolor>fg</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>12</left><top>292</top><width>432</width><height>26</height>
          <font>arc-small</font><align>center</align><textcolor>muted</textcolor>
          <label>$INFO[ListItem.Label2]</label>
        </control>
      </control>
    </definition>
  </include>
</includes>
