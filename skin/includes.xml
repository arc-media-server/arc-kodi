  <include name="RoundIconButton">
    <!-- A round button on the title page, as the Android app's: glass (white at 16%) and white
         when focused, the icon black then. `group` is the id the Python places it by (the
         buttons showing depend on the title) and `x` where it starts. -->
    <param name="id"/><param name="group"/><param name="icon"/><param name="x" default="0"/>
    <definition>
      <control type="group" id="$PARAM[group]">
        <left>$PARAM[x]</left><top>8</top><width>64</width><height>64</height>
        <control type="button" id="$PARAM[id]">
          <left>0</left><top>0</top><width>64</width><height>64</height>
          <texturefocus border="32">arc-pill-white-64.png</texturefocus>
          <texturenofocus border="32" colordiffuse="29FFFFFF">arc-pill-white-64.png</texturenofocus>
          <onup>noop</onup><ondown>noop</ondown>
        </control>
        <control type="image">
          <left>17</left><top>17</top><width>30</width><height>30</height>
          <texture>$PARAM[icon]</texture><colordiffuse>white</colordiffuse>
          <visible>!Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>17</left><top>17</top><width>30</width><height>30</height>
          <texture>$PARAM[icon]</texture><colordiffuse>black</colordiffuse>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
      </control>
    </definition>
  </include>

  <!-- An episode on a show's page, as the Android app's EpisodeCard: the picture (with progress,
       the tick and the Not on disk dimming), then "S1 · E3" small and muted, the title on one
