<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared pieces for the windows in skin/. tools/build_skin.py expands them into each window,
     because Kodi only reads includes, colours and fonts from the user's active skin. -->
<includes>
  <!-- Arc's colours (the Android app's ui/theme/Theme.kt: Background, Surface, Surface2...). No UI
       colour: chosen and main controls are white with black text. The logo is white too
       (docs/brand). Also in tools/make_media.py. -->
  <constant name="bg">FF0B0B10</constant>
  <constant name="surface">FF15151C</constant>
  <constant name="surface2">FF1F1F28</constant>
  <constant name="fg">FFF5F5F7</constant>
  <constant name="muted">FFA1A1AD</constant>
  <constant name="subtle">FF6B6B78</constant>
  <constant name="white">FFFFFFFF</constant>
  <constant name="black">FF000000</constant>
  <!-- Second line of words on a white (focused) row. -->
  <constant name="on-white-muted">FF3A3A40</constant>
  <!-- The title page's wash when a title has no palette (the Apple app's ArcColor.wash):
       top left, top right, bottom left, bottom right. Also in arc/titlepage.py (WASH). -->
  <constant name="wash-tl">FF25282D</constant>
  <constant name="wash-tr">FF222429</constant>
  <constant name="wash-bl">FF1B1B1D</constant>
  <constant name="wash-br">FF1E1F1E</constant>

  <!-- Fonts: an add-on can't bring its own, so these are the standard names every Kodi skin
       (Estuary first) defines. Sizes at 1080p in Estuary are in the comments. -->
  <constant name="arc-small">font12</constant>        <!-- 25 -->
  <constant name="arc-body">font13</constant>         <!-- 30 -->
  <constant name="arc-label">font13</constant>        <!-- 30 -->
  <constant name="arc-row">font32_title</constant>    <!-- 32 bold -->
  <constant name="arc-title">font52_title</constant>  <!-- 52 bold -->
  <constant name="arc-hero">font60</constant>         <!-- 60 -->
  <constant name="arc-code">font60</constant>
  <constant name="arc-tiny">font10</constant>         <!-- 23: an episode card's description -->
  <constant name="arc-caption">font20_title</constant> <!-- 20 bold: MORE, an episode's number -->
  <constant name="arc-card-title">font27</constant>   <!-- 27: an episode card's title -->

  <!-- Arc's toast: a short message at the top right, over any of Arc's windows, in place of
       Kodi's notification (kodi/toast.py). It never takes the focus: it shows while the global
       property arc.toast (on Kodi's Home window) has words, and fades. -->
  <include name="ArcToast">
    <definition>
      <control type="group">
        <left>1060</left><top>48</top><width>780</width><height>112</height>
        <visible>!String.IsEmpty(Window(Home).Property(arc.toast))</visible>
        <animation effect="fade" time="200">VisibleChange</animation>
        <animation effect="slide" start="0,-24" end="0,0" time="200" tween="cubic" easing="out">Visible</animation>
        <control type="image">
          <left>0</left><top>0</top><width>780</width><height>112</height>
          <texture border="38" colordiffuse="F2FFFFFF">arc-pill-surface.png</texture>
        </control>
        <control type="image">
          <left>32</left><top>36</top><width>51</width><height>40</height>
          <texture>arc-mark.png</texture>
        </control>
        <control type="label">
          <left>112</left><top>8</top><width>636</width><height>96</height>
          <font>arc-body</font><textcolor>fg</textcolor><aligny>center</aligny><wrapmultiline>true</wrapmultiline>
          <label>$INFO[Window(Home).Property(arc.toast)]</label>
        </control>
      </control>
    </definition>
  </include>

  <!-- Every page's background: Arc's near-black, flat (the Android app's Background). -->
  <include name="PageBackground">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-white.png</texture><colordiffuse>bg</colordiffuse>
    </control>
  </include>

  <!-- Artwork-led background: the focused title's fanart, darkened toward the foot. -->
  <include name="HeroBackground">
    <param name="id" default="60"/>
    <definition>
      <control type="image" id="$PARAM[id]">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <aspectratio>scale</aspectratio>
        <fadetime>300</fadetime>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>arc-scrim.png</texture>
      </control>
    </definition>
  </include>

  <!-- A white, black-text button (the page's main action and chosen place). -->
  <include name="PrimaryButton">
    <param name="width" default="320"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <disabledcolor>subtle</disabledcolor>
      <texturefocus border="38">arc-pill-white.png</texturefocus>
      <texturenofocus border="38">arc-pill-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
    </definition>
  </include>

  <!-- A key on Arc's on-screen keyboard (search): a rounded key, white when focused. -->
  <include name="KeyLook">
    <definition>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <texturefocus border="28">arc-pill-white-56.png</texturefocus>
      <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
    </definition>
  </include>

  <!-- A pill in a page's top bar (Sort, Filters, the Watchlist's, Play All and Shuffle), as the
       Android app's HeaderButton: sized to its words, glass (white at 10%) and white when
       focused. -->
  <include name="HeaderPill">
    <definition>
      <width>auto</width><height>64</height>
      <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
      <texturefocus border="32">arc-pill-white-64.png</texturefocus>
      <texturenofocus border="32" colordiffuse="FF23232A">arc-pill-white-64.png</texturenofocus>
      <aligny>center</aligny><align>center</align><textoffsetx>32</textoffsetx>
    </definition>
  </include>

  <!-- A pill-shaped secondary button (the round actions with words, Sort, Filter). -->
  <include name="PillButton">
    <param name="width" default="260"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <texturefocus border="38">arc-pill-white.png</texturefocus>
      <texturenofocus border="38">arc-pill-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
      <textoffsetx>28</textoffsetx>
    </definition>
  </include>

  <!-- A card's top right corner, as the Android app's WatchBadge: a white circle with a black
       tick for something watched, or a show's episodes still to watch in a white rounded badge
       with black words. Both sit 12 in from the picture's corner (6 dp). Kodi can't size a
       picture to its words, so the badge has a width for one, two and three digits; the params
       are their lefts (the picture's right edge less 12, less the width: 40, 54, 68), and the
       tick's (less 44). -->
  <include name="WatchBadge">
    <param name="tick"/><param name="one"/><param name="two"/><param name="three"/>
    <param name="top" default="20"/>
    <definition>
      <control type="image">
        <left>$PARAM[tick]</left><top>$PARAM[top]</top><width>44</width><height>44</height>
        <texture>arc-tick.png</texture>
        <visible>String.IsEqual(ListItem.Property(watched),true)</visible>
      </control>
      <control type="group">
        <visible>!String.IsEmpty(ListItem.Property(unwatched)) + !String.IsEqual(ListItem.Property(watched),true)</visible>
        <control type="image">
          <left>$PARAM[one]</left><top>$PARAM[top]</top><width>40</width><height>36</height>
          <texture border="12">arc-count-badge.png</texture>
          <visible>!Integer.IsGreater(ListItem.Property(unwatched),9)</visible>
        </control>
        <control type="image">
          <left>$PARAM[two]</left><top>$PARAM[top]</top><width>54</width><height>36</height>
          <texture border="12">arc-count-badge.png</texture>
          <visible>Integer.IsGreater(ListItem.Property(unwatched),9) + !Integer.IsGreater(ListItem.Property(unwatched),99)</visible>
        </control>
        <control type="image">
          <left>$PARAM[three]</left><top>$PARAM[top]</top><width>68</width><height>36</height>
          <texture border="12">arc-count-badge.png</texture>
          <visible>Integer.IsGreater(ListItem.Property(unwatched),99)</visible>
        </control>
        <!-- The number, right-aligned 14 in from the badge's right (7 dp), fits all three. -->
        <control type="label">
          <left>$PARAM[three]</left><top>$PARAM[top]</top><width>54</width><height>36</height>
          <font>arc-small</font><align>right</align><aligny>center</aligny><textcolor>black</textcolor>
          <label>$INFO[ListItem.Property(unwatched)]</label>
        </control>
      </control>
    </definition>
  </include>

  <!-- A poster card (rows and grids). `border` is set only in the focused layout. -->
  <include name="PosterCard">
    <param name="focused" default="false"/>
    <param name="labelcolor" default="muted"/>
    <definition>
      <control type="image">
        <left>8</left><top>8</top><width>244</width><height>366</height>
        <texture>arc-mask-poster.png</texture>
        <colordiffuse>surface</colordiffuse>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>244</width><height>366</height>
        <aspectratio>scale</aspectratio>
        <texture background="true" diffuse="arc-mask-poster.png">$INFO[ListItem.Art(thumb)]</texture>
      </control>
      <control type="image">
        <left>2</left><top>2</top><width>256</width><height>378</height>
        <texture>arc-ring-poster.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>20</left><top>20</top><width>220</width><height>340</height>
        <font>arc-small</font><shadowcolor>99000000</shadowcolor><textcolor>muted</textcolor><align>center</align><aligny>center</aligny>
        <wrapmultiline>true</wrapmultiline>
        <label>$INFO[ListItem.Label]</label>
        <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
      </control>
      <include content="WatchBadge"><param name="tick" value="196"/><param name="one" value="200"/><param name="two" value="186"/><param name="three" value="172"/></include>
      <control type="progress">
        <left>16</left><top>358</top><width>228</width><height>8</height>
        <texturebg border="4">arc-bar-bg.png</texturebg>
        <midtexture border="4">arc-bar-fg.png</midtexture>
        <info>ListItem.PercentPlayed</info>
        <visible>!String.IsEmpty(ListItem.Property(progress))</visible>
      </control>
      <control type="label">
        <left>8</left><top>384</top><width>244</width><height>34</height>
        <font>arc-small</font><shadowcolor>99000000</shadowcolor><align>center</align>
        <textcolor>$PARAM[labelcolor]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>8</left><top>416</top><width>244</width><height>30</height>
        <font>arc-small</font><shadowcolor>99000000</shadowcolor><align>center</align><textcolor>subtle</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>

  <!-- A wide card (Continue Watching, home videos, episodes). -->
  <include name="ThumbCard">
    <param name="focused" default="false"/>
    <param name="labelcolor" default="muted"/>
    <definition>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <texture>arc-mask-thumb.png</texture>
        <colordiffuse>surface</colordiffuse>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <aspectratio>scale</aspectratio>
        <texture background="true" diffuse="arc-mask-thumb.png">$INFO[ListItem.Art(thumb)]</texture>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <texture>arc-mask-thumb.png</texture><colordiffuse>B3000000</colordiffuse>
        <visible>!String.IsEmpty(ListItem.Property(releases))</visible>
      </control>
      <!-- A word on the picture (Watch Together's "Watching now"). -->
      <control type="image">
        <left>20</left><top>20</top><width>230</width><height>44</height>
        <texture border="22">arc-pill-white-56.png</texture><colordiffuse>A6000000</colordiffuse>
        <visible>!String.IsEmpty(ListItem.Property(tag))</visible>
      </control>
      <control type="label">
        <left>20</left><top>20</top><width>230</width><height>44</height>
        <font>arc-small</font><textcolor>fg</textcolor><align>center</align><aligny>center</aligny>
        <label>$INFO[ListItem.Property(tag)]</label>
        <visible>!String.IsEmpty(ListItem.Property(tag))</visible>
      </control>
      <control type="image">
        <left>2</left><top>2</top><width>476</width><height>273</height>
        <texture>arc-ring-thumb.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <include content="WatchBadge"><param name="tick" value="416"/><param name="one" value="420"/><param name="two" value="406"/><param name="three" value="392"/></include>
      <control type="progress">
        <left>20</left><top>250</top><width>440</width><height>8</height>
        <texturebg border="4">arc-bar-bg.png</texturebg>
        <midtexture border="4">arc-bar-fg.png</midtexture>
        <info>ListItem.PercentPlayed</info>
        <visible>!String.IsEmpty(ListItem.Property(progress))</visible>
      </control>
      <control type="label">
        <left>8</left><top>278</top><width>464</width><height>34</height>
        <font>arc-small</font><shadowcolor>99000000</shadowcolor><align>center</align>
        <textcolor>$PARAM[labelcolor]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>8</left><top>310</top><width>464</width><height>30</height>
        <font>arc-small</font><shadowcolor>99000000</shadowcolor><align>center</align><textcolor>subtle</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>

  <!-- The icon sidebar (as the Apple app's): icons always showing; on focus it opens into a
       glass panel with names, the chosen place white with black text. -->
  <include name="Sidebar">
    <control type="group">
      <control type="image">
        <left>0</left><top>0</top><width>460</width><height>1080</height>
        <texture>arc-side-panel.png</texture>
        <visible>Control.HasFocus(50)</visible>
        <animation effect="fade" time="150">VisibleChange</animation>
      </control>
      <!-- The logo sits on the icons' column: the TV mark is centred on the icons (x 84), and the
           full logo, shown when the sidebar opens, starts with the same TV at the same place and
           height, so only the name appears beside it. Both images are cropped to their drawing. -->
      <control type="image">
        <left>58</left><top>62</top><width>51</width><height>40</height>
        <texture>arc-mark.png</texture>
        <visible>!Control.HasFocus(50)</visible>
      </control>
      <control type="image">
        <left>58</left><top>62</top><width>161</width><height>40</height>
        <texture>arc-logo.png</texture>
        <visible>Control.HasFocus(50)</visible>
      </control>
      <control type="list" id="50">
        <left>20</left><top>160</top><width>420</width><height>900</height>
        <onright>900</onright>
        <onup>noop</onup><ondown>noop</ondown>
        <scrolltime>200</scrolltime>
        <itemlayout width="420" height="84">
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>muted</colordiffuse>
          </control>
          <control type="label">
            <left>112</left><top>0</top><width>290</width><height>84</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>muted</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(50)</visible>
          </control>
        </itemlayout>
        <focusedlayout width="420" height="84">
          <control type="image">
            <left>0</left><top>4</top><width>400</width><height>76</height>
            <texture border="38">arc-pill-white.png</texture>
            <visible>Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>black</colordiffuse>
            <visible>Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>fg</colordiffuse>
            <visible>!Control.HasFocus(50)</visible>
          </control>
          <control type="label">
            <left>112</left><top>0</top><width>290</width><height>84</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>black</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(50)</visible>
          </control>
        </focusedlayout>
      </control>
    </control>
  </include>

  <!-- A round button showing only an icon (the title page's), white with a black icon when
       focused. Its name shows beside the row (Window.Property(arc.hint)). -->
  <!-- A menu's rows (the player's menus and Arc's own menu dialog): a tick for the chosen one,
       the name, a detail at the right; the focused row is white with black text. 548 wide. -->
  <include name="MenuLayouts">
    <definition>
        <itemlayout width="548" height="64">
          <control type="image">
            <left>16</left><top>17</top><width>30</width><height>30</height>
            <texture>arc-osd-check.png</texture><colordiffuse>white</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(selected),1)</visible>
          </control>
          <control type="label">
            <left>62</left><top>0</top><width>470</width><height>64</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>fg</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <!-- Star rating: icons replace unsupported font glyphs, preserving the label for accessibility. -->
            <visible>!String.IsEqual(ListItem.Property(arc.ratingposition),label)</visible>
          </control>
          <control type="label">
            <left>300</left><top>0</top><width>228</width><height>64</height>
            <font>arc-small</font><aligny>center</aligny><align>right</align><textcolor>muted</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <!-- Star rating: the existing label/detail slots, independent of the skin font. -->
          <control type="image">
            <left>62</left><top>16</top><width>140</width><height>32</height>
            <aspectratio align="left">keep</aspectratio>
            <texture>$INFO[ListItem.Property(arc.ratingtexture)]</texture><colordiffuse>fg</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(arc.ratingposition),label)</visible>
          </control>
          <control type="image">
            <left>388</left><top>16</top><width>140</width><height>32</height>
            <aspectratio align="right">keep</aspectratio>
            <texture>$INFO[ListItem.Property(arc.ratingtexture)]</texture><colordiffuse>fg</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(arc.ratingposition),detail)</visible>
          </control>
        </itemlayout>
        <focusedlayout width="548" height="64">
          <control type="image">
            <left>0</left><top>0</top><width>548</width><height>64</height>
            <texture border="32">arc-pill-white-64.png</texture>
          </control>
          <control type="image">
            <left>16</left><top>17</top><width>30</width><height>30</height>
            <texture>arc-osd-check.png</texture><colordiffuse>black</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(selected),1)</visible>
          </control>
          <control type="label">
            <left>62</left><top>0</top><width>470</width><height>64</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>black</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <!-- Star rating: icons replace unsupported font glyphs, preserving the label for accessibility. -->
            <visible>!String.IsEqual(ListItem.Property(arc.ratingposition),label)</visible>
          </control>
          <control type="label">
            <left>300</left><top>0</top><width>228</width><height>64</height>
            <font>arc-small</font><aligny>center</aligny><align>right</align><textcolor>on-white-muted</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <!-- Star rating: the existing label/detail slots, independent of the skin font. -->
          <control type="image">
            <left>62</left><top>16</top><width>140</width><height>32</height>
            <aspectratio align="left">keep</aspectratio>
            <texture>$INFO[ListItem.Property(arc.ratingtexture)]</texture><colordiffuse>black</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(arc.ratingposition),label)</visible>
          </control>
          <control type="image">
            <left>388</left><top>16</top><width>140</width><height>32</height>
            <aspectratio align="right">keep</aspectratio>
            <texture>$INFO[ListItem.Property(arc.ratingtexture)]</texture><colordiffuse>black</colordiffuse>
            <visible>String.IsEqual(ListItem.Property(arc.ratingposition),detail)</visible>
          </control>
        </focusedlayout>
    </definition>
  </include>

  <!-- A library's tabs (Recommended, Browse, Collections), as the Apple app's pill bar: each a
       pill sized to its word, the one showing lit, the focused one white with black text. Three
       slots, each a "current" (121 + 2i) and an "other" (122 + 2i) button; the Python shows one
       of each slot's pair with the window property arc.tab<i>. Select switches. -->
  <!-- A page's heading (id 101: a library's name, or the page's), and for a library its tabs
       beside it, as the Android app's: one glass pill holding Recommended, Library and
       Collections (Folders for Other videos), the showing tab lighter and the focused one white.
       Each tab is a button drawing its own slice of the holder (tools/make_media.py,
       library_tabs), so a library has exactly three tabs: first, middle and last. Slot i's
       "current" button is 121 + 2i, its "other" button 122 + 2i (kodi/windows/library.py). -->
  <include name="PageHeader">
    <param name="left" default="80"/><param name="top" default="34"/>
    <param name="ondown"/><param name="onright" default="noop"/>
    <definition>
      <control type="grouplist" id="130">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>1300</width><height>76</height>
        <orientation>horizontal</orientation><itemgap>40</itemgap>
        <!-- The tabs sit inside this row, which takes their moves at its ends: the same as theirs. -->
        <onup>noop</onup><ondown>$PARAM[ondown]</ondown><onleft>noop</onleft><onright>$PARAM[onright]</onright>
        <control type="label" id="101">
          <width>auto</width><height>76</height>
          <font>arc-title</font><textcolor>fg</textcolor><aligny>center</aligny><label></label>
        </control>
        <control type="grouplist" id="120">
          <width>900</width><height>76</height>
          <orientation>horizontal</orientation><itemgap>0</itemgap>
          <onup>noop</onup><ondown>$PARAM[ondown]</ondown><onleft>noop</onleft><onright>$PARAM[onright]</onright>
        <control type="button" id="121">
          <width>auto</width><height>76</height>
          <font>arc-label</font><align>center</align><aligny>center</aligny><textoffsetx>36</textoffsetx>
          <textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
          <texturefocus border="38,0,38,0">arc-tab-l-focus.png</texturefocus>
          <texturenofocus border="38,0,38,0">arc-tab-l-current.png</texturenofocus>
          <visible>String.IsEqual(Window.Property(arc.tab0),current)</visible>
        </control>
        <control type="button" id="122">
