<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared pieces for the windows in skin/. tools/build_skin.py expands them into each window,
     because Kodi only reads includes, colours and fonts from the user's active skin. -->
<includes>
  <!-- Arc's colours (web dark tokens; the same as the Apple app's Theme.swift). No UI colour:
       chosen and main controls are white with black text. The logo is white too (docs/brand). -->
  <constant name="bg">FF1C1D21</constant>
  <constant name="surface">FF26272D</constant>
  <constant name="surface2">FF2F3038</constant>
  <constant name="fg">FFF5F5F7</constant>
  <constant name="muted">FFA1A1AD</constant>
  <constant name="subtle">FF6B6B78</constant>
  <constant name="white">FFFFFFFF</constant>
  <constant name="black">FF000000</constant>

  <!-- Fonts: an add-on can't bring its own, so these are the standard names every Kodi skin
       (Estuary first) defines. Sizes at 1080p in Estuary are in the comments. -->
  <constant name="arc-small">font12</constant>        <!-- 25 -->
  <constant name="arc-body">font13</constant>         <!-- 30 -->
  <constant name="arc-label">font13</constant>        <!-- 30 -->
  <constant name="arc-row">font32_title</constant>    <!-- 32 bold -->
  <constant name="arc-title">font52_title</constant>  <!-- 52 bold -->
  <constant name="arc-hero">font60</constant>         <!-- 60 -->
  <constant name="arc-code">font60</constant>

  <include name="PageBackground">
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-wash.png</texture>
    </control>
  </include>

  <!-- Artwork-led background: the focused title's fanart, darkened toward the foot. -->
  <include name="HeroBackground">
    <param name="id" default="60"/>
    <definition>
      <control type="image" id="$PARAM[id]">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <aspectratio>scale</aspectratio>
        <fadetime>300</fadetime>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>arc-scrim.png</texture>
      </control>
    </definition>
  </include>

  <!-- A white, black-text button (the page's main action and chosen place). -->
  <include name="PrimaryButton">
    <param name="width" default="320"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <disabledcolor>subtle</disabledcolor>
      <texturefocus border="38">arc-pill-white.png</texturefocus>
      <texturenofocus border="38">arc-pill-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
    </definition>
  </include>

  <!-- A pill-shaped secondary button (the round actions with words, Sort, Filter). -->
  <include name="PillButton">
    <param name="width" default="260"/>
    <definition>
      <width>$PARAM[width]</width><height>76</height>
      <font>arc-label</font>
      <textcolor>fg</textcolor>
      <focusedcolor>black</focusedcolor>
      <texturefocus border="38">arc-pill-white.png</texturefocus>
      <texturenofocus border="38">arc-pill-surface.png</texturenofocus>
      <aligny>center</aligny><align>center</align>
      <textoffsetx>28</textoffsetx>
    </definition>
  </include>

  <!-- A poster card (rows and grids). `border` is set only in the focused layout. -->
  <include name="PosterCard">
    <param name="focused" default="false"/>
    <param name="labelcolor" default="muted"/>
    <definition>
      <control type="image">
        <left>8</left><top>8</top><width>244</width><height>366</height>
        <texture>arc-mask-poster.png</texture>
        <colordiffuse>surface</colordiffuse>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>244</width><height>366</height>
        <aspectratio>scale</aspectratio>
        <texture background="true" diffuse="arc-mask-poster.png">$INFO[ListItem.Art(thumb)]</texture>
      </control>
      <control type="image">
        <left>2</left><top>2</top><width>256</width><height>378</height>
        <texture>arc-ring-poster.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>20</left><top>20</top><width>220</width><height>340</height>
        <font>arc-small</font><textcolor>muted</textcolor><align>center</align><aligny>center</aligny>
        <wrapmultiline>true</wrapmultiline>
        <label>$INFO[ListItem.Label]</label>
        <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
      </control>
      <control type="image">
        <left>196</left><top>16</top><width>48</width><height>48</height>
        <texture>arc-tick.png</texture>
        <visible>String.IsEqual(ListItem.Property(watched),true)</visible>
      </control>
      <control type="progress">
        <left>16</left><top>358</top><width>228</width><height>8</height>
        <texturebg border="4">arc-bar-bg.png</texturebg>
        <midtexture border="4">arc-bar-fg.png</midtexture>
        <info>ListItem.PercentPlayed</info>
        <visible>!String.IsEmpty(ListItem.Property(progress))</visible>
      </control>
      <control type="label">
        <left>8</left><top>384</top><width>244</width><height>34</height>
        <font>arc-small</font><align>center</align>
        <textcolor>$PARAM[labelcolor]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>8</left><top>416</top><width>244</width><height>30</height>
        <font>arc-small</font><align>center</align><textcolor>subtle</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>

  <!-- A wide card (Continue Watching, home videos, episodes). -->
  <include name="ThumbCard">
    <param name="focused" default="false"/>
    <param name="labelcolor" default="muted"/>
    <definition>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <texture>arc-mask-thumb.png</texture>
        <colordiffuse>surface</colordiffuse>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <aspectratio>scale</aspectratio>
        <texture background="true" diffuse="arc-mask-thumb.png">$INFO[ListItem.Art(thumb)]</texture>
      </control>
      <control type="image">
        <left>8</left><top>8</top><width>464</width><height>261</height>
        <texture>arc-mask-thumb.png</texture><colordiffuse>B3000000</colordiffuse>
        <visible>!String.IsEmpty(ListItem.Property(releases))</visible>
      </control>
      <control type="image">
        <left>2</left><top>2</top><width>476</width><height>273</height>
        <texture>arc-ring-thumb.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="progress">
        <left>20</left><top>250</top><width>440</width><height>8</height>
        <texturebg border="4">arc-bar-bg.png</texturebg>
        <midtexture border="4">arc-bar-fg.png</midtexture>
        <info>ListItem.PercentPlayed</info>
        <visible>!String.IsEmpty(ListItem.Property(progress))</visible>
      </control>
      <control type="label">
        <left>8</left><top>278</top><width>464</width><height>34</height>
        <font>arc-small</font><align>center</align>
        <textcolor>$PARAM[labelcolor]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>8</left><top>310</top><width>464</width><height>30</height>
        <font>arc-small</font><align>center</align><textcolor>subtle</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>

  <!-- The icon sidebar (as the Apple app's): icons always showing; on focus it opens into a
       glass panel with names, the chosen place white with black text. -->
  <include name="Sidebar">
    <control type="group">
      <control type="image">
        <left>0</left><top>0</top><width>460</width><height>1080</height>
        <texture>arc-side-panel.png</texture>
        <visible>Control.HasFocus(50)</visible>
        <animation effect="fade" time="150">VisibleChange</animation>
      </control>
      <!-- The logo sits on the icons' column: the TV mark is centred on the icons (x 84), and the
           full logo, shown when the sidebar opens, starts with the same TV at the same place and
           height, so only the name appears beside it. Both images are cropped to their drawing. -->
      <control type="image">
        <left>58</left><top>62</top><width>51</width><height>40</height>
        <texture>arc-mark.png</texture>
        <visible>!Control.HasFocus(50)</visible>
      </control>
      <control type="image">
        <left>58</left><top>62</top><width>161</width><height>40</height>
        <texture>arc-logo.png</texture>
        <visible>Control.HasFocus(50)</visible>
      </control>
      <control type="list" id="50">
        <left>20</left><top>160</top><width>420</width><height>900</height>
        <onright>900</onright>
        <onup>noop</onup><ondown>noop</ondown>
        <scrolltime>200</scrolltime>
        <itemlayout width="420" height="84">
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>muted</colordiffuse>
          </control>
          <control type="label">
            <left>112</left><top>0</top><width>290</width><height>84</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>muted</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(50)</visible>
          </control>
        </itemlayout>
        <focusedlayout width="420" height="84">
          <control type="image">
            <left>0</left><top>4</top><width>400</width><height>76</height>
            <texture border="38">arc-pill-white.png</texture>
            <visible>Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>black</colordiffuse>
            <visible>Control.HasFocus(50)</visible>
          </control>
          <control type="image">
            <left>42</left><top>20</top><width>44</width><height>44</height>
            <texture>arc-icon-$INFO[ListItem.Property(icon)].png</texture>
            <colordiffuse>fg</colordiffuse>
            <visible>!Control.HasFocus(50)</visible>
          </control>
          <control type="label">
            <left>112</left><top>0</top><width>290</width><height>84</height>
            <font>arc-label</font><aligny>center</aligny><textcolor>black</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(50)</visible>
          </control>
        </focusedlayout>
      </control>
    </control>
  </include>

  <!-- A round button showing only an icon (the title page's), white with a black icon when
       focused. Its name shows beside the row (Window.Property(arc.hint)). -->
  <include name="RoundIconButton">
    <param name="id"/><param name="icon"/><param name="left"/><param name="right"/>
    <definition>
      <control type="group">
        <width>76</width><height>76</height>
        <control type="button" id="$PARAM[id]">
          <left>0</left><top>0</top><width>76</width><height>76</height>
          <texturefocus border="38">arc-pill-white.png</texturefocus>
          <texturenofocus border="38">arc-pill-surface.png</texturenofocus>
          <onup>noop</onup><ondown>200</ondown>
          <onleft>$PARAM[left]</onleft><onright>$PARAM[right]</onright>
        </control>
        <control type="image">
          <left>21</left><top>21</top><width>34</width><height>34</height>
          <texture>$PARAM[icon]</texture><colordiffuse>white</colordiffuse>
          <visible>!Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>21</left><top>21</top><width>34</width><height>34</height>
          <texture>$PARAM[icon]</texture><colordiffuse>black</colordiffuse>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
      </control>
    </definition>
  </include>

  <!-- A person on a Cast row: a round photo (or their initials), name and part. -->
  <include name="FaceCard">
    <param name="focused" default="false"/>
    <param name="labelcolor" default="muted"/>
    <definition>
      <control type="image">
        <left>20</left><top>10</top><width>160</width><height>160</height>
        <texture>arc-mask-face.png</texture><colordiffuse>surface</colordiffuse>
      </control>
      <control type="label">
        <left>20</left><top>10</top><width>160</width><height>160</height>
        <font>arc-title</font><align>center</align><aligny>center</aligny><textcolor>muted</textcolor>
        <label>$INFO[ListItem.Property(initials)]</label>
      </control>
      <!-- Photos are portrait (2:3): drawn 160x240 with a mask whose circle is the top 160, so
           the circle stays round (a square mask on a cropped photo is stretched into an oval). -->
      <control type="image">
        <left>20</left><top>10</top><width>160</width><height>240</height>
        <aspectratio>scale</aspectratio>
        <texture background="true" diffuse="arc-mask-face-portrait.png">$INFO[ListItem.Art(thumb)]</texture>
      </control>
      <control type="image">
        <left>14</left><top>4</top><width>172</width><height>172</height>
        <texture>arc-ring-face.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>0</left><top>186</top><width>200</width><height>34</height>
        <font>arc-small</font><align>center</align><textcolor>$PARAM[labelcolor]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="label">
        <left>0</left><top>218</top><width>200</width><height>30</height>
        <font>arc-small</font><align>center</align><textcolor>subtle</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>

  <!-- An About / Details / Crew / Playback card: a heading and lines of text. -->
  <include name="InfoCard">
    <param name="focused" default="false"/>
    <definition>
      <control type="image">
        <left>0</left><top>0</top><width>430</width><height>360</height>
        <texture border="24">arc-panel.png</texture>
      </control>
      <control type="image">
        <left>-6</left><top>-6</top><width>442</width><height>372</height>
        <texture border="26">arc-panel-ring.png</texture>
        <visible>$PARAM[focused]</visible>
      </control>
      <control type="label">
        <left>28</left><top>22</top><width>374</width><height>40</height>
        <font>arc-label</font><textcolor>fg</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="textbox">
        <left>28</left><top>70</top><width>374</width><height>270</height>
        <font>arc-small</font><textcolor>muted</textcolor>
        <label>$INFO[ListItem.Property(body)]</label>
      </control>
    </definition>
  </include>

  <!-- A horizontal row of cards with its title, for Home and the title page. -->
  <include name="PosterRow">
    <param name="title"/><param name="list"/><param name="onleft" default=""/>
    <!-- Rows run to the screen's right edge: width is from the row's left to 1920. -->
    <param name="width" default="1728"/>
    <definition>
      <!-- Title and list sit directly in the parent grouplist (as Estuary's widgets do), so Up and
           Down move between rows; both show only once the list has cards. -->
      <control type="label" id="$PARAM[title]">
        <left>8</left><width>1500</width><height>50</height>
        <font>arc-row</font><textcolor>fg</textcolor>
        <visible>Integer.IsGreater(Container($PARAM[list]).NumItems,0)</visible>
      </control>
      <control type="list" id="$PARAM[list]">
        <width>$PARAM[width]</width><height>450</height>
        <visible>Integer.IsGreater(Container($PARAM[list]).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>8</itemgap>
        <scrolltime tween="cubic" easing="out">220</scrolltime>
        <preloaditems>2</preloaditems>
        <onleft>$PARAM[onleft]</onleft>
        <itemlayout width="268" height="450"><include>PosterCard</include></itemlayout>
        <focusedlayout width="268" height="450">
          <include content="PosterCard"><param name="focused" value="Control.HasFocus($PARAM[list])"/><param name="labelcolor" value="fg"/></include>
        </focusedlayout>
      </control>
    </definition>
  </include>

  <include name="ThumbRow">
    <param name="title"/><param name="list"/><param name="onleft" default=""/>
    <!-- Rows run to the screen's right edge: width is from the row's left to 1920. -->
    <param name="width" default="1728"/>
    <definition>
      <!-- Title and list sit directly in the parent grouplist (as Estuary's widgets do), so Up and
           Down move between rows; both show only once the list has cards. -->
      <control type="label" id="$PARAM[title]">
        <left>8</left><width>1500</width><height>50</height>
        <font>arc-row</font><textcolor>fg</textcolor>
        <visible>Integer.IsGreater(Container($PARAM[list]).NumItems,0)</visible>
      </control>
      <control type="list" id="$PARAM[list]">
        <width>$PARAM[width]</width><height>450</height>
        <visible>Integer.IsGreater(Container($PARAM[list]).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>8</itemgap>
        <scrolltime tween="cubic" easing="out">220</scrolltime>
        <preloaditems>2</preloaditems>
        <onleft>$PARAM[onleft]</onleft>
        <itemlayout width="488" height="450"><include>ThumbCard</include></itemlayout>
        <focusedlayout width="488" height="450">
          <include content="ThumbCard"><param name="focused" value="Control.HasFocus($PARAM[list])"/><param name="labelcolor" value="fg"/></include>
        </focusedlayout>
      </control>
    </definition>
  </include>
</includes>
