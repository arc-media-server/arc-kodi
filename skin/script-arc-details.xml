<?xml version="1.0" encoding="UTF-8"?>
<!-- A title's page, as the Apple app's: the artwork over the title's own four colours (Kodi tints
     the corner glows with the palette), fading into them at the left and the foot. One column
     scrolls: the hero (logo, info, badges, overview, Starring), Play and the round buttons, a
     show's seasons and episodes, Related, Cast, Collections, Trailers & Extras, and the About,
     Details, Crew and Playback cards. Up/Down is Kodi's own grouplist navigation. -->
<window>
  <defaultcontrol>100</defaultcontrol>
  <controls>
    <include>PageBackground</include>
    <control type="image" id="120"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-tl.png</texture><colordiffuse>wash-tl</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="121"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-tr.png</texture><colordiffuse>wash-tr</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="122"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-bl.png</texture><colordiffuse>wash-bl</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="123"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-br.png</texture><colordiffuse>wash-br</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="115">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <aspectratio>scale</aspectratio><fadetime>300</fadetime>
      <texture diffuse="arc-hero-mask.png"></texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-title-scrim.png</texture>
    </control>

    <control type="grouplist" id="900">
      <left>112</left><top>0</top><width>1808</width><height>1080</height>
      <orientation>vertical</orientation><itemgap>24</itemgap>
      <scrolltime tween="cubic" easing="out">300</scrolltime>
      <onup>noop</onup><ondown>noop</ondown>

      <!-- The hero, as the Apple app's: the logo (or title); the rating boxed with the genres;
           the overview; the year and length with the file's quality capsules. Not focusable; it
           scrolls away as the page moves down. -->
      <control type="group" id="130">
        <width>1808</width><height>640</height>
        <control type="image" id="110">
          <left>8</left><top>90</top><width>640</width><height>200</height>
          <aspectratio align="left" aligny="bottom">keep</aspectratio>
        </control>
        <control type="label" id="111">
          <shadowcolor>CC000000</shadowcolor>
          <left>8</left><top>190</top><width>1100</width><height>100</height>
          <font>arc-hero</font><textcolor>fg</textcolor>
        </control>
        <control type="grouplist" id="140">
          <left>8</left><top>316</top><width>1150</width><height>40</height>
          <orientation>horizontal</orientation><itemgap>14</itemgap><usecontrolcoords>false</usecontrolcoords>
          <control type="button" id="141">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>16</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>!String.IsEmpty(Window.Property(arc.rating))</visible>
          </control>
          <control type="label" id="142">
            <width>auto</width><height>40</height><shadowcolor>CC000000</shadowcolor>
            <font>arc-body</font><textcolor>fg</textcolor><aligny>center</aligny>
          </control>
        </control>
        <control type="textbox" id="113">
          <shadowcolor>CC000000</shadowcolor>
          <left>10</left><top>376</top><width>1000</width><height>160</height>
          <font>arc-body</font><textcolor>DDF5F5F7</textcolor>
        </control>
        <control type="grouplist" id="150">
          <left>8</left><top>556</top><width>1150</width><height>40</height>
          <orientation>horizontal</orientation><itemgap>14</itemgap>
          <control type="label" id="112">
            <width>auto</width><height>40</height><shadowcolor>CC000000</shadowcolor>
            <font>arc-body</font><textcolor>DDF5F5F7</textcolor><aligny>center</aligny>
          </control>
          <control type="button" id="160">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap0),f)</visible>
          </control>
          <control type="button" id="161">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap0),o)</visible>
          </control>
          <control type="button" id="162">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap1),f)</visible>
          </control>
          <control type="button" id="163">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap1),o)</visible>
          </control>
          <control type="button" id="164">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap2),f)</visible>
          </control>
          <control type="button" id="165">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap2),o)</visible>
          </control>
          <control type="button" id="166">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap3),f)</visible>
          </control>
          <control type="button" id="167">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap3),o)</visible>
          </control>
          <control type="button" id="168">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap4),f)</visible>
          </control>
          <control type="button" id="169">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap4),o)</visible>
          </control>
          <control type="button" id="170">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap5),f)</visible>
          </control>
          <control type="button" id="171">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap5),o)</visible>
          </control>
        </control>
      </control>

      <!-- Play, then round buttons; the focused one's name shows beside the row. -->
      <control type="group" id="98">
        <width>1808</width><height>80</height>
        <!-- A plain group, not a grouplist: a horizontal grouplist takes over Left/Right and can't
             move into the round buttons' groups. -->
        <control type="group" id="99">
          <left>8</left><top>0</top><width>1300</width><height>80</height>
          <control type="button" id="100">
            <include content="SmallPrimaryButton"><param name="width" value="280"/></include>
            <top>8</top>
            <onup>noop</onup><ondown>200</ondown><onleft>noop</onleft><onright>101</onright>
            <label>$ADDON[script.arc 30005]</label>
          </control>
          <include content="RoundIconButton"><param name="id" value="101"/><param name="icon" value="arc-osd-rotate-ccw.png"/><param name="left" value="100"/><param name="right" value="102"/><param name="x" value="296"/></include>
          <include content="RoundIconButton"><param name="id" value="102"/><param name="icon" value="$INFO[Window.Property(arc.watchedicon)]"/><param name="left" value="101"/><param name="right" value="103"/><param name="x" value="376"/></include>
          <include content="RoundIconButton"><param name="id" value="103"/><param name="icon" value="$INFO[Window.Property(arc.watchlisticon)]"/><param name="left" value="102"/><param name="right" value="noop"/><param name="x" value="456"/></include>
        </control>
        <!-- Starring and Director at the right, level with the buttons, as the Apple app's. -->
        <control type="label" id="95">
          <left>1120</left><top>-2</top><width>620</width><height>40</height>
          <font>arc-small</font><textcolor>fg</textcolor><align>right</align><aligny>top</aligny>
          <wrapmultiline>true</wrapmultiline>
          <shadowcolor>CC000000</shadowcolor>
        </control>
        <control type="label" id="96">
          <left>1120</left><top>36</top><width>620</width><height>40</height>
          <font>arc-small</font><textcolor>fg</textcolor><align>right</align><aligny>center</aligny>
          <shadowcolor>CC000000</shadowcolor>
        </control>
        <control type="label" id="97">
          <left>540</left><top>0</top><width>360</width><height>80</height>
          <font>arc-small</font><textcolor>fg</textcolor><aligny>center</aligny><shadowcolor>CC000000</shadowcolor>
          <label>$INFO[Window.Property(arc.hint)]</label>
          <visible>Control.HasFocus(101) | Control.HasFocus(102) | Control.HasFocus(103)</visible>
        </control>
      </control>

      <!-- A show's seasons and episodes. -->
      <control type="list" id="200">
        <!-- Tabs 280 wide: room for "Not in This Order" (episodes outside the show's order). -->
        <left>8</left><width>1700</width><height>76</height>
        <visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>12</itemgap>
        <itemlayout width="280" height="76">
          <control type="label"><left>0</left><top>0</top><width>280</width><height>76</height>
            <font>arc-label</font><align>center</align><aligny>center</aligny><textcolor>C8F5F5F7</textcolor>
            <shadowcolor>CC000000</shadowcolor><label>$INFO[ListItem.Label]</label></control>
        </itemlayout>
        <focusedlayout width="280" height="76">
          <control type="image"><left>0</left><top>0</top><width>280</width><height>76</height>
            <texture border="38">arc-pill-white.png</texture>
            <visible>Control.HasFocus(200)</visible></control>
          <control type="label"><left>0</left><top>0</top><width>280</width><height>76</height>
            <font>arc-label</font><align>center</align><aligny>center</aligny><textcolor>black</textcolor>
            <label>$INFO[ListItem.Label]</label><visible>Control.HasFocus(200)</visible></control>
          <control type="label"><left>0</left><top>0</top><width>280</width><height>76</height>
            <font>arc-label</font><align>center</align><aligny>center</aligny><textcolor>fg</textcolor>
            <shadowcolor>CC000000</shadowcolor><label>$INFO[ListItem.Label]</label><visible>!Control.HasFocus(200)</visible></control>
        </focusedlayout>
      </control>
      <!-- The episodes and, under them, the focused one's description, as one unit: the
           grouplist scrolls the whole group into view, so the description shows the first time
           the focus lands on the episodes (it used to sit below the screen's foot until the page
           had scrolled further). -->
      <control type="group">
        <defaultcontrol always="true">201</defaultcontrol>
        <height>500</height>
        <visible>Integer.IsGreater(Container(201).NumItems,0)</visible>
      <control type="list" id="201">
        <top>0</top><width>1808</width><height>350</height>
        <visible>Integer.IsGreater(Container(201).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>8</itemgap>
        <scrolltime tween="cubic" easing="out">220</scrolltime>
        <itemlayout width="488" height="350"><include>ThumbCard</include></itemlayout>
        <focusedlayout width="488" height="350">
          <include content="ThumbCard"><param name="focused" value="Control.HasFocus(201)"/><param name="labelcolor" value="fg"/></include>
        </focusedlayout>
      </control>
      <control type="textbox" id="202">
        <left>8</left><top>360</top><width>1400</width><height>114</height>
        <font>arc-small</font><textcolor>DDF5F5F7</textcolor><shadowcolor>CC000000</shadowcolor>
        <label>$INFO[Container(201).ListItem.Property(overview)]</label>
        <visible>Control.HasFocus(201) + !String.IsEmpty(Container(201).ListItem.Property(overview))</visible>
      </control>
      </control>



      <!-- The rows in the Apple app's order: the cast first (owner, 7 November), then trailers
           and extras, Related and Collections. -->
      <!-- Cast & Crew: round photos, name and part. -->
      <control type="group">
        <defaultcontrol always="true">330</defaultcontrol>
        <height>364</height>
        <visible>Integer.IsGreater(Container(330).NumItems,0)</visible>
      <control type="label" id="331">
        <left>8</left><top>0</top><width>1500</width><height>50</height>
        <font>arc-row</font><textcolor>fg</textcolor><shadowcolor>CC000000</shadowcolor>
        <visible>Integer.IsGreater(Container(330).NumItems,0)</visible>
      </control>
      <control type="list" id="330">
        <top>74</top><width>1808</width><height>290</height>
        <visible>Integer.IsGreater(Container(330).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>12</itemgap>
        <scrolltime tween="cubic" easing="out">220</scrolltime>
        <itemlayout width="200" height="290"><include>FaceCard</include></itemlayout>
        <focusedlayout width="200" height="290">
          <include content="FaceCard"><param name="focused" value="Control.HasFocus(330)"/><param name="labelcolor" value="fg"/></include>
        </focusedlayout>
      </control>
      </control>

      <include content="ThumbRow"><param name="title" value="351"/><param name="list" value="350"/><param name="width" value="1808"/></include>

      <include content="PosterRow"><param name="title" value="311"/><param name="list" value="300"/><param name="width" value="1808"/></include>
      <include content="PosterRow"><param name="title" value="341"/><param name="list" value="340"/><param name="width" value="1808"/></include>

      <!-- About, Details, Crew, Playback. -->
      <!-- About, Details, Crew, Playback: 40 apart, with room under them inside the list (the
           page scrolls only until the list's foot meets the screen's). -->
      <control type="list" id="360">
        <left>-10</left><width>1818</width><height>420</height>
        <visible>Integer.IsGreater(Container(360).NumItems,0)</visible>
        <orientation>horizontal</orientation><itemgap>0</itemgap>
        <itemlayout width="440" height="420"><include>InfoCard</include></itemlayout>
        <focusedlayout width="440" height="420">
          <include content="InfoCard"><param name="focused" value="Control.HasFocus(360)"/></include>
        </focusedlayout>
      </control>
      <control type="group"><height>40</height></control>
    </control>
  </controls>
</window>
