          <include content="RoundIconButton"><param name="id" value="101"/><param name="group" value="191"/><param name="icon" value="arc-osd-rotate-ccw.png"/><param name="x" value="300"/></include>
          <include content="RoundIconButton"><param name="id" value="104"/><param name="group" value="192"/><param name="icon" value="arc-osd-shuffle.png"/><param name="x" value="384"/></include>
