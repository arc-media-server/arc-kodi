          </control>
        </control>
        </control>

        <!-- Play, then the round buttons (Play from the Beginning, Shuffle, Watched, Watchlist,
             ⋯), as the Android app's; the Python places the ones this title shows and links
             their Left/Right. A plain group, not a grouplist: a horizontal grouplist takes over
             Left/Right and can't move into the round buttons' groups. -->
        <control type="group" id="99">
          <left>8</left><top>920</top><width>1300</width><height>80</height>
          <!-- Play: a glass pill, white when focused, with the play icon, how far through (part
               watched) and what it plays. The words are labels (186, 187) so they can follow the
               bar. -->
          <control type="button" id="100">
            <left>0</left><top>8</top><width>280</width><height>64</height>
            <texturefocus border="32">arc-pill-white-64.png</texturefocus>
            <texturenofocus border="32" colordiffuse="29FFFFFF">arc-pill-white-64.png</texturenofocus>
            <label/>
            <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>101</onright>
          </control>
          <control type="image">
            <left>34</left><top>27</top><width>26</width><height>26</height>
            <texture>arc-osd-play.png</texture><colordiffuse>white</colordiffuse>
            <visible>!Control.HasFocus(100)</visible>
          </control>
          <control type="image">
            <left>34</left><top>27</top><width>26</width><height>26</height>
            <texture>arc-osd-play.png</texture><colordiffuse>black</colordiffuse>
            <visible>Control.HasFocus(100)</visible>
          </control>
          <control type="group" id="188">
            <left>76</left><top>36</top><width>72</width><height>8</height>
            <control type="image">
              <left>0</left><top>0</top><width>72</width><height>8</height>
              <texture border="4">arc-bar-fg.png</texture><colordiffuse>4DFFFFFF</colordiffuse>
              <visible>!Control.HasFocus(100)</visible>
            </control>
            <control type="image">
              <left>0</left><top>0</top><width>72</width><height>8</height>
              <texture border="4">arc-bar-fg.png</texture><colordiffuse>4D000000</colordiffuse>
              <visible>Control.HasFocus(100)</visible>
            </control>
            <control type="image" id="189">
              <left>0</left><top>0</top><width>36</width><height>8</height>
              <texture border="4">arc-bar-fg.png</texture><colordiffuse>white</colordiffuse>
              <visible>!Control.HasFocus(100)</visible>
