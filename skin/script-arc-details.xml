            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>black</disabledcolor><textcolor>black</textcolor>
            <texturenofocus border="20">arc-badge-fill.png</texturenofocus><texturefocus border="20">arc-badge-fill.png</texturefocus>
            <visible>String.IsEqual(Window.Property(arc.cap0),f)</visible>
          </control>
          <control type="button" id="161">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>18</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
