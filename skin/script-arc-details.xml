          <left>-12</left><top>716</top><width>1100</width><height>196</height>
          <texturefocus border="32" colordiffuse="33FFFFFF">arc-pill-white-64.png</texturefocus><texturenofocus/>
          <label/>
          <onup>noop</onup><ondown>100</ondown><onleft>noop</onleft><onright>noop</onright>
        </control>
        <control type="textbox" id="113">
          <shadowcolor>CC000000</shadowcolor>
          <left>10</left><top>732</top><width>1040</width><height>126</height>
          <font>arc-body</font><textcolor>D9F5F5F7</textcolor>
        </control>
        <control type="label" id="116">
          <left>10</left><top>858</top><width>400</width><height>30</height>
          <font>arc-caption</font><textcolor>fg</textcolor><shadowcolor>CC000000</shadowcolor>
        </control>
        <control type="group" id="151">
          <left>10</left><top>856</top><width>1150</width><height>40</height>
