<!-- A title's page, as the Android app's: the artwork over the title's own four colours (Kodi
     tints the corner glows with the palette), fading into them at the left and the foot. One
     column scrolls: the header low on the first screen (logo, rating and genres, overview, the
     year and length with the quality capsules, Play and the round buttons, Starring and Directed
     by at the right), a show's season bar just under it and the episodes below, then Cast,
     Trailers & Extras, Related, Collections and the About, Details, Crew and Playback cards. The
     header's parts are placed from the foot up by the Python (kodi/windows/details.py, from
     arc/titlepage.py's hero_layout), as Kodi can't stack controls of varying heights upwards. -->
<window>
  <defaultcontrol>100</defaultcontrol>
  <controls>
    <include>PageBackground</include>
    <control type="image" id="120"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-tl.png</texture><colordiffuse>wash-tl</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="121"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-tr.png</texture><colordiffuse>wash-tr</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="122"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-bl.png</texture><colordiffuse>wash-bl</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="123"><left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-mesh-br.png</texture><colordiffuse>wash-br</colordiffuse><fadetime>400</fadetime></control>
    <control type="image" id="115">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <aspectratio>scale</aspectratio><fadetime>300</fadetime>
      <texture diffuse="arc-hero-mask.png"></texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-title-scrim.png</texture>
    </control>
    <!-- Once the page has scrolled past the header (focus on the episodes or below), the artwork
         dims behind the rows, as Home's and the Android app's HeroBackdrop (82% of the page's
         colour). -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-white.png</texture><colordiffuse>D10B0B10</colordiffuse>
      <visible>String.IsEqual(Window.Property(scrolled),true)</visible>
      <animation effect="fade" time="250">VisibleChange</animation>
    </control>

    <control type="grouplist" id="900">
      <left>112</left><top>0</top><width>1808</width><height>1080</height>
      <!-- As Home's (skin/script-arc-home.xml): the focused row always lands at the foot of the
           screen, going down or up. Each row is a screen-tall group with the row at its foot; the
           -540 gap overlaps them and the spacer before each row (the row's height plus 24) spaces
           them. The season bar and the episodes share one group, so they move together. -->
      <orientation>vertical</orientation><itemgap>-540</itemgap>
      <scrolltime tween="cubic" easing="out">300</scrolltime>
      <onup>noop</onup><ondown>noop</ondown>

      <!-- The header: a film's fills the first screen (a margin at the foot), a show's leaves
           room for its season bar under it. Not focusable itself (the description, when cut,
           and the buttons are); its parts are placed by the Python, these are a film's. -->
      <control type="group" id="130">
        <width>1808</width><height>1080</height>
        <control type="image" id="110">
          <left>8</left><top>400</top><width>920</width><height>240</height>
          <aspectratio align="left" aligny="bottom">keep</aspectratio>
        </control>
        <control type="label" id="111">
          <shadowcolor>CC000000</shadowcolor>
          <left>8</left><top>556</top><width>1300</width><height>84</height>
          <font>arc-hero</font><textcolor>fg</textcolor>
        </control>
        <!-- An episode's own page: "S1 · E4 · Pilot" under the show's logo. -->
        <control type="label" id="117">
          <left>10</left><top>656</top><width>1300</width><height>40</height>
          <font>arc-body</font><textcolor>fg</textcolor><shadowcolor>CC000000</shadowcolor>
        </control>
        <!-- The age rating boxed, then the genres. -->
        <!-- (Grouplists sit in plain groups the Python can move: Kodi's Python can't take hold of
             a grouplist.) -->
        <control type="group" id="143">
          <left>8</left><top>672</top><width>1150</width><height>40</height>
        <control type="grouplist" id="140">
          <left>0</left><top>0</top><width>1150</width><height>40</height>
          <orientation>horizontal</orientation><itemgap>24</itemgap><usecontrolcoords>false</usecontrolcoords>
          <control type="button" id="141">
            <width>auto</width><height>40</height><enable>false</enable>
            <font>arc-small</font><align>center</align><aligny>center</aligny><textoffsetx>16</textoffsetx>
            <disabledcolor>fg</disabledcolor><textcolor>fg</textcolor>
            <texturenofocus border="20">arc-badge-line.png</texturenofocus><texturefocus border="20">arc-badge-line.png</texturefocus>
            <visible>!String.IsEmpty(Window.Property(arc.rating))</visible>
          </control>
          <control type="label" id="142">
            <width>auto</width><height>40</height><shadowcolor>CC000000</shadowcolor>
            <font>arc-body</font><textcolor>fg</textcolor><aligny>center</aligny>
          </control>
        </control>
        </control>
        <!-- The description (three lines) and, when that cuts it, MORE under it; then the year,
             length and score with the quality capsules. When cut, the whole block takes the
             focus (glass behind it) and opens the full text, as the Android app's. -->
