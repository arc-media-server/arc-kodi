<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol>100</defaultcontrol>
  <controls>
    <include>PageBackground</include>
    <control type="label" id="101">
      <left>80</left><top>48</top><width>1200</width><height>60</height>
      <font>arc-title</font><textcolor>fg</textcolor><label></label>
      <visible>String.IsEmpty(Window.Property(arc.tab0))</visible>
    </control>
    <include content="LibraryTabs"><param name="ondown" value="100"/><param name="onright" value="102"/></include>
    <!-- A collection's overview (empty elsewhere); the Python moves the grid down under it. -->
    <control type="textbox" id="107">
      <left>80</left><top>150</top><width>1300</width><height>76</height>
      <font>arc-small</font><textcolor>muted</textcolor>
    </control>
    <control type="label" id="104">
      <left>80</left><top>112</top><width>400</width><height>36</height>
      <font>arc-small</font><textcolor>muted</textcolor><label></label>
    </control>
    <!-- Play All and Shuffle, for a collection or a playlist (hidden elsewhere). -->
    <control type="button" id="108">
      <include content="PillButton"><param name="width" value="220"/></include>
      <left>980</left><top>40</top>
      <ondown>100</ondown><onup>noop</onup><onleft>noop</onleft><onright>109</onright>
      <label>$ADDON[script.arc 30287]</label>
    </control>
    <control type="button" id="109">
      <include content="PillButton"><param name="width" value="220"/></include>
      <left>1212</left><top>40</top>
      <ondown>100</ondown><onup>noop</onup><onleft>108</onleft>
      <onright condition="Control.IsVisible(102)">102</onright><onright condition="!Control.IsVisible(102)">noop</onright>
      <label>$ADDON[script.arc 30288]</label>
    </control>
    <control type="button" id="102">
      <include content="PillButton"><param name="width" value="420"/></include>
      <left>1180</left><top>40</top>
      <ondown>100</ondown><onup>noop</onup>
      <onleft condition="Control.IsVisible(109)">109</onleft><onleft condition="!Control.IsVisible(109)">120</onleft>
      <onright>103</onright>
      <label>$ADDON[script.arc 30123]</label>
    </control>
    <control type="button" id="103">
      <include content="PillButton"><param name="width" value="260"/></include>
      <left>1620</left><top>40</top><width>260</width>
      <ondown>100</ondown><onup>noop</onup><onleft>102</onleft><onright>noop</onright>
      <label>$ADDON[script.arc 30124]</label>
    </control>
    <control type="panel" id="100">
      <left>72</left><top>170</top><width>1800</width><height>880</height>
      <onup condition="!String.IsEmpty(Window.Property(arc.tab0))">120</onup>
      <onup condition="String.IsEmpty(Window.Property(arc.tab0)) + Control.IsVisible(108)">108</onup>
      <onup condition="String.IsEmpty(Window.Property(arc.tab0)) + !Control.IsVisible(108)">102</onup>
      <orientation>vertical</orientation>
      <!-- Posters, or wide cards for Other videos (their pictures are stills): the window property
           arc.style says which. -->
      <itemlayout width="292" height="460" condition="!String.IsEqual(Window.Property(arc.style),thumb)"><include>PosterCard</include></itemlayout>
      <focusedlayout width="292" height="460" condition="!String.IsEqual(Window.Property(arc.style),thumb)"><include content="PosterCard"><param name="focused" value="Control.HasFocus(100)"/><param name="labelcolor" value="fg"/></include></focusedlayout>
      <itemlayout width="488" height="370" condition="String.IsEqual(Window.Property(arc.style),thumb)"><include>ThumbCard</include></itemlayout>
      <focusedlayout width="488" height="370" condition="String.IsEqual(Window.Property(arc.style),thumb)"><include content="ThumbCard"><param name="focused" value="Control.HasFocus(100)"/><param name="labelcolor" value="fg"/></include></focusedlayout>
    </control>
    <control type="label" id="105">
      <left>80</left><top>500</top><width>1760</width><height>60</height>
      <font>arc-body</font><textcolor>muted</textcolor><align>center</align>
      <label></label>
    </control>
  </controls>
</window>
