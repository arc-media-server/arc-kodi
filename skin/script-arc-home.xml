<?xml version="1.0" encoding="UTF-8"?>
<!-- Home: the icon sidebar, the focused title's artwork and details, and the profile's rows.
     Each of the 12 row slots exists as posters (3001+), wide cards (3401+) and backdrop cards
     (3801+, the web's "Backdrops"); the Python fills the one the row's style asks for. -->
<window>
  <defaultcontrol>900</defaultcontrol>
  <controls>
    <include>PageBackground</include>
    <include content="HeroBackground"><param name="id" value="61"/></include>
    <!-- Once the hero has scrolled away (focus below the first row), the artwork dims behind the
         rows, as the Android app's Home (82% of the page's colour). -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-white.png</texture><colordiffuse>D10B0B10</colordiffuse>
      <visible>String.IsEqual(Window.Property(scrolled),true)</visible>
      <animation effect="fade" time="250">VisibleChange</animation>
    </control>

    <control type="grouplist" id="900">
      <left>192</left><top>0</top><width>1728</width><height>1080</height>
      <!-- The hero (the focused title's logo or name, details and overview) is the list's first
           entry, so it scrolls away above the rows, as the Android app's Home. It's 460 high, then
           each row is 620 (title 50 + gap 30 + list 510 + 30 below): the first row fills the screen
           under the hero, and Kodi, scrolling just far enough to show a row's foot, lines every
           later row up at the same height (the gap is inside each row, not between them). -->
      <orientation>vertical</orientation><itemgap>0</itemgap>
      <scrolltime tween="cubic" easing="out">260</scrolltime>
      <!-- Up on the first row and Down on the last stay put: a grouplist otherwise wraps round,
           and a held key would cycle through every row. -->
      <onleft>50</onleft><onup>noop</onup><ondown>noop</ondown>
      <control type="group">
        <width>1728</width><height>460</height>
        <!-- Focusing this scrolls the list back to the top; it passes the focus straight on to the
             first row (kodi/windows/home.py, HERO_SPOT). -->
        <control type="button" id="66">
          <left>0</left><top>0</top><width>1</width><height>1</height>
          <texturefocus/><texturenofocus/><label/>
          <onleft>50</onleft>
        </control>
        <control type="group">
          <left>8</left><top>56</top><width>1300</width><height>400</height>
          <control type="image" id="62">
            <left>0</left><top>0</top><width>640</width><height>220</height>
            <aspectratio align="left" aligny="bottom">keep</aspectratio>
            <fadetime>200</fadetime>
          </control>
          <control type="label" id="63">
            <left>0</left><top>120</top><width>1300</width><height>100</height>
            <font>arc-hero</font><textcolor>fg</textcolor>
          </control>
          <control type="label" id="64">
            <left>2</left><top>236</top><width>1300</width><height>40</height>
            <font>arc-body</font><textcolor>muted</textcolor>
          </control>
          <control type="textbox" id="65">
            <left>2</left><top>284</top><width>1000</width><height>76</height>
            <font>arc-body</font><textcolor>fg</textcolor>
          </control>
        </control>
      </control>
        <include content="PosterRow"><param name="title" value="3101"/><param name="list" value="3001"/><param name="onleft" value="50"/><param name="height" value="510"/><param name="group_height" value="620"/></include>
        <include content="ThumbRow"><param name="title" value="3501"/><param name="list" value="3401"/><param name="onleft" value="50"/><param name="height" value="510"/><param name="group_height" value="620"/></include>
