<?xml version="1.0" encoding="UTF-8"?>
<!-- Arc's on-screen keyboard (kodi/windows/keyboard.py, arc/keyboard.py), in place of Kodi's own
     for a server address, a password or a Watch Together code: what to type at the top, the text
     typed so far (dots for a password), the keys ten across, and under them Shift, the page switch
     (123 / ABC), Space, Delete, Clear and Done. A panel over the dimmed screen, as Arc's menus. -->
<window>
  <defaultcontrol always="true">702</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-white.png</texture><colordiffuse>CC000000</colordiffuse>
    </control>
    <control type="group" id="700">
      <left>400</left><top>269</top><width>1120</width><height>542</height>
      <animation effect="fade" time="150">WindowOpen</animation>
      <animation effect="fade" time="120">WindowClose</animation>
      <control type="image">
        <left>0</left><top>0</top><width>1120</width><height>542</height>
        <texture border="38" colordiffuse="F2FFFFFF">arc-pill-surface.png</texture>
      </control>
      <control type="label" id="701">
        <left>48</left><top>24</top><width>1024</width><height>50</height>
        <font>arc-label</font><textcolor>muted</textcolor>
      </control>
      <!-- The text typed so far. -->
      <control type="image">
        <left>40</left><top>88</top><width>1040</width><height>72</height>
        <texture border="32" colordiffuse="surface2">arc-pill-white-64.png</texture>
      </control>
      <control type="label" id="704">
        <left>72</left><top>88</top><width>976</width><height>72</height>
        <font>arc-label</font><textcolor>fg</textcolor><aligny>center</aligny>
      </control>

      <control type="panel" id="702">
        <left>40</left><top>184</top><width>1040</width><height>240</height>
        <orientation>vertical</orientation>
        <onup>noop</onup><ondown>712</ondown><onleft>noop</onleft><onright>noop</onright>
        <scrolltime>0</scrolltime>
        <itemlayout width="104" height="80">
          <control type="image">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <texture border="28">arc-pill-white-56.png</texture><colordiffuse>surface2</colordiffuse>
          </control>
          <control type="label">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <font>arc-label</font><textcolor>fg</textcolor><align>center</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </itemlayout>
        <focusedlayout width="104" height="80">
          <control type="image">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <texture border="28">arc-pill-white-56.png</texture><colordiffuse>surface2</colordiffuse>
            <visible>!Control.HasFocus(702)</visible>
          </control>
          <control type="image">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <texture border="28">arc-pill-white-56.png</texture>
            <visible>Control.HasFocus(702)</visible>
          </control>
          <control type="label">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <font>arc-label</font><textcolor>fg</textcolor><align>center</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
            <visible>!Control.HasFocus(702)</visible>
          </control>
          <control type="label">
            <left>0</left><top>0</top><width>94</width><height>70</height>
            <font>arc-label</font><textcolor>black</textcolor><align>center</align><aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(702)</visible>
          </control>
        </focusedlayout>
      </control>

      <control type="button" id="710">
        <left>40</left><top>432</top><width>130</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label>$ADDON[script.arc 30450]</label>
        <onup>702</onup><ondown>noop</ondown><onleft>noop</onleft><onright>711</onright>
      </control>
      <control type="button" id="711">
        <left>180</left><top>432</top><width>130</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label></label>
        <onup>702</onup><ondown>noop</ondown><onleft>710</onleft><onright>712</onright>
      </control>
      <control type="button" id="712">
        <left>320</left><top>432</top><width>250</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label>$ADDON[script.arc 30316]</label>
        <onup>702</onup><ondown>noop</ondown><onleft>711</onleft><onright>713</onright>
      </control>
      <control type="button" id="713">
        <left>580</left><top>432</top><width>170</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label>$ADDON[script.arc 30310]</label>
        <onup>702</onup><ondown>noop</ondown><onleft>712</onleft><onright>714</onright>
      </control>
      <control type="button" id="714">
        <left>760</left><top>432</top><width>150</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label>$ADDON[script.arc 30317]</label>
        <onup>702</onup><ondown>noop</ondown><onleft>713</onleft><onright>715</onright>
      </control>
      <control type="button" id="715">
        <left>920</left><top>432</top><width>160</width><height>70</height>
        <font>arc-label</font><textcolor>fg</textcolor><focusedcolor>black</focusedcolor>
        <texturefocus border="28">arc-pill-white-56.png</texturefocus>
        <texturenofocus border="28" colordiffuse="surface2">arc-pill-white-56.png</texturenofocus>
        <aligny>center</aligny><align>center</align>
        <label>$ADDON[script.arc 30453]</label>
        <onup>702</onup><ondown>noop</ondown><onleft>714</onleft><onright>noop</onright>
      </control>
    </control>
  </controls>
</window>
