<?xml version="1.0" encoding="UTF-8"?>
<!-- A library's Recommended tab, as on Android TV: poster, thumbnail or Backdrop shelves
     directly below the library tabs. Home's shared row code fills the requested style. -->
<window>
  <defaultcontrol>120</defaultcontrol>
  <controls>
    <include>PageBackground</include>
    <control type="label" id="69">
      <left>120</left><top>144</top><width>1300</width><height>44</height>
      <font>arc-body</font><textcolor>muted</textcolor>
    </control>

    <control type="grouplist" id="900">
      <left>112</left><top>130</top><width>1808</width><height>950</height>
      <!-- A focused group fills the viewport, so Kodi lands it at the same position going up
           or down. Its shelf starts at the top. Two -475 gaps cancel a group's 950 pixels,
           leaving the following spacer (shelf height plus 24) to position the next shelf. -->
      <orientation>vertical</orientation><itemgap>-475</itemgap>
      <scrolltime tween="cubic" easing="out">260</scrolltime>
      <onleft>noop</onleft><onup>120</onup><ondown>noop</ondown>
        <include content="RecommendedShelf"><param name="row" value="PosterRow"/><param name="title" value="3101"/><param name="list" value="3001"/><param name="height" value="510"/><param name="stride" value="614"/></include>
