<?xml version="1.0" encoding="UTF-8"?>
<!-- Arc's own menu, in place of Kodi's context menu, select and yes/no dialogs: a card's actions,
     Sort and Filter, a list to pick from, a question to confirm. The same panel and rows as the
     player's menus, centred over a dimmed screen. The Python sizes the panel to its rows. -->
<window>
  <defaultcontrol always="true">602</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>arc-white.png</texture><colordiffuse>99000000</colordiffuse>
    </control>
    <control type="group" id="600">
      <left>670</left><top>300</top><width>580</width><height>520</height>
      <animation effect="fade" time="150">WindowOpen</animation>
      <animation effect="fade" time="120">WindowClose</animation>
      <control type="image" id="603">
        <left>0</left><top>0</top><width>580</width><height>520</height>
        <texture border="38" colordiffuse="F2FFFFFF">arc-pill-surface.png</texture>
      </control>
      <control type="label" id="601">
        <left>32</left><top>20</top><width>516</width><height>50</height>
        <font>arc-label</font><textcolor>muted</textcolor>
      </control>
      <control type="textbox" id="604">
        <left>32</left><top>76</top><width>516</width><height>0</height>
        <font>arc-body</font><textcolor>fg</textcolor>
      </control>
      <control type="list" id="602">
        <left>16</left><top>76</top><width>548</width><height>428</height>
        <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
        <scrolltime>150</scrolltime>
        <include>MenuLayouts</include>
      </control>
    </control>
  </controls>
</window>
