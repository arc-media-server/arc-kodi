        <include content="BackdropRow"><param name="title" value="3910"/><param name="list" value="3810"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="PosterRow"><param name="title" value="3111"/><param name="list" value="3011"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="ThumbRow"><param name="title" value="3511"/><param name="list" value="3411"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="BackdropRow"><param name="title" value="3911"/><param name="list" value="3811"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="PosterRow"><param name="title" value="3112"/><param name="list" value="3012"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="ThumbRow"><param name="title" value="3512"/><param name="list" value="3412"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="BackdropRow"><param name="title" value="3912"/><param name="list" value="3812"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
    </control>

  </controls>
</window>
