        <include content="PosterRow"><param name="title" value="3107"/><param name="list" value="3007"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
        <include content="ThumbRow"><param name="title" value="3507"/><param name="list" value="3407"/><param name="onleft" value="noop"/><param name="width" value="1808"/><param name="height" value="510"/></include>
