      <control type="image" id="419"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="420"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="421"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="422"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
