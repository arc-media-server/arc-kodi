      <control type="image" id="424"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="425"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="426"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="427"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="428"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="429"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="430"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="431"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="432"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="433"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="434"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="435"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="436"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="437"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="438"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="439"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="440"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="441"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="442"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="443"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="444"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="445"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="446"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="447"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="448"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="449"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="402">
        <left>100</left><top>934</top><width>8</width><height>32</height>
        <texture border="4">arc-tl-marker.png</texture>
      </control>
      <!-- Under the marker (moved by the Python): playing or paused, and the time played. -->
      <control type="group" id="403">
        <left>100</left><top>976</top><width>240</width><height>40</height>
        <control type="image">
          <left>0</left><top>7</top><width>26</width><height>26</height>
          <texture>arc-osd-pause.png</texture>
          <visible>!String.IsEqual(Window.Property(arc.paused),1)</visible>
        </control>
        <control type="image">
          <left>0</left><top>7</top><width>26</width><height>26</height>
          <texture>arc-osd-play.png</texture>
          <visible>String.IsEqual(Window.Property(arc.paused),1)</visible>
        </control>
        <control type="label" id="404">
          <left>38</left><top>0</top><width>200</width><height>40</height>
          <font>arc-body</font><textcolor>white</textcolor>
        </control>
      </control>
      <control type="label" id="405">
        <left>1420</left><top>976</top><width>400</width><height>40</height>
        <font>arc-body</font><textcolor>white</textcolor><align>right</align>
      </control>
    </control>

    <!-- The timeline thumbnail while Left/Right builds up a skip (arc.thumb), above the marker; the
         Python moves group 460 along with the marker and sets image 461. -->
    <control type="group" id="460">
      <left>100</left><top>740</top><width>328</width><height>188</height>
      <visible>String.IsEqual(Window.Property(arc.thumb),1)</visible>
      <control type="image">
        <left>0</left><top>0</top><width>328</width><height>188</height>
        <texture>arc-white.png</texture><colordiffuse>E6FFFFFF</colordiffuse>
      </control>
      <control type="image" id="461">
        <left>4</left><top>4</top><width>320</width><height>180</height>
        <aspectratio>scale</aspectratio>
      </control>
    </control>

    <!-- A menu: Playback (and its Quality and Version), Audio or Subtitles. -->
    <control type="group" id="600">
      <left>1240</left><top>290</top><width>580</width><height>520</height>
      <visible>String.IsEqual(Window.Property(arc.menu),1)</visible>
      <animation effect="fade" time="150">VisibleChange</animation>
      <control type="image" id="603">
        <left>0</left><top>0</top><width>580</width><height>520</height>
        <texture border="38" colordiffuse="F2FFFFFF">arc-pill-surface.png</texture>
      </control>
      <control type="label" id="601">
        <left>32</left><top>20</top><width>516</width><height>50</height>
        <font>arc-label</font><textcolor>muted</textcolor>
      </control>
      <control type="list" id="602">
        <left>16</left><top>76</top><width>548</width><height>448</height>
        <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
        <scrolltime>150</scrolltime>
        <include>MenuLayouts</include>
      </control>
    </control>

    <!-- Skip Intro/Recap/Credits (focused when it appears, as Plex's). -->
    <control type="button" id="100">
      <left>1480</left><top>880</top><width>340</width><height>76</height>
      <visible>String.IsEqual(Window.Property(arc.skip),1) + !String.IsEqual(Window.Property(arc.osd),1)</visible>
      <include content="PrimaryButton"><param name="width" value="340"/></include>
      <texturenofocus border="38">arc-pill-white.png</texturenofocus>
      <textcolor>black</textcolor>
      <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
      <label>$ADDON[script.arc 30180]</label>
      <animation effect="fade" time="200">VisibleChange</animation>
    </control>

    <!-- Up Next. -->
    <control type="group" id="101">
      <left>1260</left><top>680</top><width>560</width><height>300</height>
      <visible>String.IsEqual(Window.Property(arc.upnext),1) + !String.IsEqual(Window.Property(arc.osd),1)</visible>
      <animation effect="slide" start="0,40" time="250" tween="cubic" easing="out">Visible</animation>
      <control type="image">
        <left>0</left><top>0</top><width>560</width><height>300</height>
        <texture border="38" colordiffuse="F2FFFFFF">arc-pill-surface.png</texture>
      </control>
      <control type="label" id="102">
        <left>32</left><top>24</top><width>496</width><height>36</height>
        <font>arc-small</font><textcolor>muted</textcolor>
        <label>$ADDON[script.arc 30183]</label>
      </control>
      <control type="label" id="104">
        <left>32</left><top>64</top><width>496</width><height>80</height>
        <font>arc-label</font><textcolor>fg</textcolor><wrapmultiline>true</wrapmultiline>
      </control>
      <control type="label" id="106">
        <left>32</left><top>144</top><width>496</width><height>36</height>
        <font>arc-small</font><textcolor>muted</textcolor>
      </control>
      <control type="button" id="103">
        <left>32</left><top>196</top><width>300</width><height>76</height>
        <include content="PrimaryButton"><param name="width" value="300"/></include>
        <label>$ADDON[script.arc 30005]</label>
        <onright>105</onright><onleft>noop</onleft><onup>noop</onup><ondown>noop</ondown>
      </control>
      <control type="button" id="105">
        <left>348</left><top>196</top><width>180</width><height>76</height>
        <include content="PillButton"><param name="width" value="180"/></include>
        <textoffsetx>0</textoffsetx>
        <label>$ADDON[script.arc 30003]</label>
        <onleft>103</onleft><onright>noop</onright><onup>noop</onup><ondown>noop</ondown>
      </control>
    </control>
