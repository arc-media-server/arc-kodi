<!-- Arc's player (kodi/player_osd.py): a window over Kodi's video for the whole playback that owns
     the remote, as PM4K's does, laid out as the Apple and Android players:
     - at the bottom left the title (an episode's "S2, E4 · name" above its show), and to its
       right three round buttons, Playback, Audio and Subtitles, each opening a menu above it;
     - the timeline under them, the time played under its marker and the time left at the end;
     - Skip Intro/Recap/Credits and Up Next at the bottom right while the controls are hidden.
     What shows is driven by window properties (a fixed <visible> would override setVisible):
     arc.osd (the controls), arc.menu (a menu), arc.skip, arc.upnext, arc.paused, arc.seeking. -->
<window>
  <defaultcontrol>90</defaultcontrol>
  <controls>
    <!-- Holds the focus while the controls are hidden, so every key reaches the player. -->
    <control type="button" id="90">
      <left>0</left><top>0</top><width>1</width><height>1</height>
      <texturefocus></texturefocus><texturenofocus></texturenofocus>
      <onup>noop</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
    </control>

    <control type="group" id="200">
      <visible>String.IsEqual(Window.Property(arc.osd),1)</visible>
      <animation effect="fade" time="200">VisibleChange</animation>
      <control type="image">
        <left>0</left><top>480</top><width>1920</width><height>600</height>
        <texture>arc-osd-scrim.png</texture>
      </control>

      <!-- Paused, the title's overview shows above it (as Plex's player). -->
      <control type="textbox" id="203">
        <left>100</left><top>712</top><width>1300</width><height>78</height>
        <font>arc-small</font><textcolor>DDFFFFFF</textcolor><shadowcolor>CC000000</shadowcolor>
        <visible>String.IsEqual(Window.Property(arc.paused),1) + String.IsEmpty(Window.Property(arc.thumb))</visible>
      </control>
      <control type="label" id="201">
        <left>100</left><top>800</top><width>1300</width><height>40</height>
        <font>arc-body</font><textcolor>CCFFFFFF</textcolor>
      </control>
      <control type="label" id="202">
        <left>100</left><top>836</top><width>1300</width><height>76</height>
        <font>arc-title</font><textcolor>white</textcolor>
      </control>

      <!-- Playback, Audio, Subtitles: round, white with a black icon when focused. -->
      <control type="button" id="301">
        <left>1560</left><top>836</top><width>76</width><height>76</height>
        <texturefocus border="38">arc-pill-white.png</texturefocus>
        <texturenofocus border="38" colordiffuse="99FFFFFF">arc-pill-surface.png</texturenofocus>
        <onleft>noop</onleft><onright>302</onright><onup>noop</onup><ondown>noop</ondown>
      </control>
      <control type="button" id="302">
        <left>1652</left><top>836</top><width>76</width><height>76</height>
        <texturefocus border="38">arc-pill-white.png</texturefocus>
        <texturenofocus border="38" colordiffuse="99FFFFFF">arc-pill-surface.png</texturenofocus>
        <onleft>301</onleft><onright>303</onright><onup>noop</onup><ondown>noop</ondown>
      </control>
      <control type="button" id="303">
        <left>1744</left><top>836</top><width>76</width><height>76</height>
        <texturefocus border="38">arc-pill-white.png</texturefocus>
        <texturenofocus border="38" colordiffuse="99FFFFFF">arc-pill-surface.png</texturenofocus>
        <onleft>302</onleft><onright>noop</onright><onup>noop</onup><ondown>noop</ondown>
      </control>
      <control type="image">
        <left>1581</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-sliders-horizontal.png</texture><colordiffuse>white</colordiffuse>
        <visible>!Control.HasFocus(301)</visible>
      </control>
      <control type="image">
        <left>1581</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-sliders-horizontal.png</texture><colordiffuse>black</colordiffuse>
        <visible>Control.HasFocus(301)</visible>
      </control>
      <control type="image">
        <left>1673</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-volume-2.png</texture><colordiffuse>white</colordiffuse>
        <visible>!Control.HasFocus(302)</visible>
      </control>
      <control type="image">
        <left>1673</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-volume-2.png</texture><colordiffuse>black</colordiffuse>
        <visible>Control.HasFocus(302)</visible>
      </control>
      <control type="image">
        <left>1765</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-captions.png</texture><colordiffuse>white</colordiffuse>
        <visible>!Control.HasFocus(303)</visible>
      </control>
      <control type="image">
        <left>1765</left><top>857</top><width>34</width><height>34</height>
        <texture>arc-osd-captions.png</texture><colordiffuse>black</colordiffuse>
        <visible>Control.HasFocus(303)</visible>
      </control>

      <!-- The timeline. 400 takes the focus (it has no look of its own; the marker grows). -->
      <control type="button" id="400">
        <left>100</left><top>930</top><width>1720</width><height>40</height>
        <texturefocus></texturefocus><texturenofocus></texturenofocus>
        <onleft>noop</onleft><onright>noop</onright><onup>noop</onup><ondown>noop</ondown>
      </control>
      <control type="progress" id="401">
        <left>100</left><top>944</top><width>1720</width><height>12</height>
        <texturebg border="6">arc-tl-bg.png</texturebg>
        <midtexture border="6">arc-tl-fg.png</midtexture>
      </control>
      <!-- Chapter marks: small gaps in the bar where chapters start (placed and shown by the
           Python, 410-449). -->
      <control type="image" id="410"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="411"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
      <control type="image" id="412"><left>0</left><top>944</top><width>4</width><height>12</height><texture>arc-white.png</texture><colordiffuse>B3000000</colordiffuse></control>
